<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>andy-cli</AssemblyName>
    <RootNamespace>Andy.Cli</RootNamespace>
    <SelfContained>false</SelfContained>
    <!-- Enable JSON reflection for trimming compatibility -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Reproducible restore: pin the package graph via packages.lock.json (see dependency-manifest.json). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!--
      Default date-based version for the Andy ecosystem. The release workflow
      (.github/workflows/release.yml) overrides this at publish time via
      -p:Version. It flows to AssemblyVersion / FileVersion /
      InformationalVersion and is shown next to the header.
    -->
    <Version>2026.5.30</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Andy.Acp.Core" Version="2026.7.21.1" />
    <PackageReference Include="Andy.CodeIndex.Infrastructure" Version="2026.7.21-rc.11" />
    <PackageReference Include="Andy.Engine" Version="2026.7.31-rc.98" />
    <PackageReference Include="Andy.Llm" Version="2026.7.21-rc.76" />
    <PackageReference Include="Andy.MCP" Version="2026.5.16-rc.31" />
    <PackageReference Include="Andy.Model" Version="2026.7.21-rc.13" />
    <PackageReference Include="Andy.Permissions" Version="2026.7.27-rc.16" />
    <PackageReference Include="Andy.Skills.Tools" Version="2026.7.21-rc.17" />
    <PackageReference Include="Andy.Tools" Version="2026.7.21-rc.86" />
    <PackageReference Include="Andy.Tools.Data" Version="2026.7.21-rc.86" />
    <PackageReference Include="Andy.Tools.Pdf" Version="2026.7.21-rc.86" />
    <PackageReference Include="Andy.Tui" Version="2026.7.21-rc.162" />
    <PackageReference Include="JsonRepairSharp" Version="1.2.4" />
    <PackageReference Include="JsonSchema.Net" Version="9.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
  </ItemGroup>

  <!--
    Keep the linker package deterministic: trimmed publishing otherwise adds it
    implicitly at the SDK's own version, which makes packages.lock.json depend
    on whichever SDK runs restore.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Embed the AQ1 headless-config schema so andy-cli run (headless mode)
    can validate without depending on the schemas/ directory at runtime.
    LogicalName is load-bearing: HeadlessConfigLoader looks it up by this
    exact string.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\headless-config.v1.json">
      <LogicalName>Andy.Cli.schemas.headless-config.v1.json</LogicalName>
    </EmbeddedResource>
    <!--
      Layered andy.jsonc configuration schema (rivoli-ai/andy-cli#280). Same
      arrangement: ConfigSchema looks the resource up by this exact LogicalName so a
      published binary validates without the schemas/ directory beside it.
    -->
    <EmbeddedResource Include="..\..\schemas\andy-config.v1.json">
      <LogicalName>Andy.Cli.schemas.andy-config.v1.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <!-- Disable trimming for Andy.* assemblies to avoid anonymous type issues -->
  <ItemGroup>
    <!-- Andy.Acp.Core wire models are (de)serialized via reflection-based
         System.Text.Json; trimming their members breaks ACP mode at the first
         initialize message. -->
    <TrimmerRootAssembly Include="Andy.Acp.Core" />
    <TrimmerRootAssembly Include="Andy.Skills" />
    <TrimmerRootAssembly Include="Andy.Skills.Tools" />
    <TrimmerRootAssembly Include="Andy.Tools" />
    <TrimmerRootAssembly Include="Andy.Tools.Data" />
    <TrimmerRootAssembly Include="Andy.Tools.Pdf" />
    <TrimmerRootAssembly Include="Andy.Llm" />
    <TrimmerRootAssembly Include="Andy.Engine" />
    <TrimmerRootAssembly Include="Andy.Model" />
    <!-- Andy.Tui became a meta-package (no assembly of its own); root each of
         its split assemblies instead. -->
    <TrimmerRootAssembly Include="Andy.Tui.Animations" />
    <TrimmerRootAssembly Include="Andy.Tui.Backend.Terminal" />
    <TrimmerRootAssembly Include="Andy.Tui.Compose" />
    <TrimmerRootAssembly Include="Andy.Tui.Compositor" />
    <TrimmerRootAssembly Include="Andy.Tui.Core" />
    <TrimmerRootAssembly Include="Andy.Tui.DisplayList" />
    <TrimmerRootAssembly Include="Andy.Tui.Input" />
    <TrimmerRootAssembly Include="Andy.Tui.Layout" />
    <TrimmerRootAssembly Include="Andy.Tui.Observability" />
    <TrimmerRootAssembly Include="Andy.Tui.Style" />
    <TrimmerRootAssembly Include="Andy.Tui.Text" />
    <TrimmerRootAssembly Include="Andy.Tui.Virtualization" />
    <TrimmerRootAssembly Include="Andy.Tui.Widgets" />
  </ItemGroup>

  <!--
    For local (non-CI) builds, derive a meaningful InformationalVersion from git so
    `dotnet run` shows the actual build (commit date + short sha, e.g. "2026.06.20-dev")
    instead of the static fallback <Version>, which otherwise stays frozen until a release.
    Release builds pass -p:Version / -p:InformationalVersion (a global property this target
    cannot override) and run with CI=true, so they are unaffected. Git failures are ignored
    (ContinueOnError), leaving the static <Version> fallback for tarball/no-git builds.
  -->
  <Target Name="SetDevInformationalVersion" BeforeTargets="GetAssemblyAttributes" Condition="'$(CI)' != 'true'">
    <Exec Command="git show -s --format=%cs HEAD" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitDate" />
    </Exec>
    <Exec Command="git rev-parse --short=9 HEAD" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShortSha" />
    </Exec>
    <PropertyGroup Condition="'$(_GitShortSha)' != '' and '$(_GitCommitDate)' != ''">
      <InformationalVersion>$(_GitCommitDate.Trim().Replace('-','.'))-dev+$(_GitShortSha.Trim())</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
